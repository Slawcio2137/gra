# Skopiuj jako scripts/itch.env (ten plik NIE jest commitowany).
# Albo ustaw te same zmienne w systemie / w sesji PowerShell.

# Twoj login itch.io (bez @, bez .itch.io) — widac w URL profilu:
#   https://ITCH_USER.itch.io/
ITCH_USER=twoj_login

# Opcjonalnie: nazwa gry w URL (domyslnie not-that-real-life)
# ITCH_GAME=not-that-real-life

# Opcjonalnie: kanal butlera (domyslnie android)
# ITCH_CHANNEL=android

# Klucz API: NIE wklejaj tu na stale do repo.
# Zrob raz:  butler login
# Albo ustaw w sesji przed uploadem:
#   $env:ITCH_API_KEY = "klucz_z_https://itch.io/user/settings/api-keys"
#   (albo $env:BUTLER_API_KEY — to samo)